# 环境变量配置示例

# ============ S3 对象存储配置 ============
## 开发环境使用MinIO, 生产环境可替换成阿里云
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
S3_BUCKET=video-localization

# ============ Redis 配置 ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis123
## 开发环境设为 False, 测试和生产环境设为 True
REDIS_SSL=False
REDIS_DB=0

# ============ BullMQ 配置 ============
QUEUE_NAME=latentsync_task

# ============ 模型配置 ============
MODEL_CONFIG_PATH=configs/unet/stage2_512.yaml
MODEL_CHECKPOINT_PATH=checkpoints/latentsync_unet.pt
